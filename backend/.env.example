# Copy to .env and replace every <...> placeholder with local values.
NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=<local-database-name>
DB_USER=<local-runtime-role>
DB_PASSWORD=<local-database-password>

# Generate a unique secret locally; do not reuse this template or commit .env.
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-unique-random-secret>
JWT_EXPIRES_IN=1d

# Local development email verification link; the backend prints it to its terminal.
EMAIL_VERIFICATION_URL=http://localhost:4200/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400

# Optional: absolute private directory outside any served/public folder.
# PRIVATE_DOCUMENT_STORAGE_PATH=<absolute-private-storage-directory>

# Required only for guarded backend tests; target the dedicated ngo_connect_test database.
TEST_DATABASE_URL=<postgresql-url-for-ngo_connect_test>
